index.html<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VERONICA</title>
<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #130d24;
  color: white;
  text-align: center;
}
header {
  padding: 35px 10px;
  color: #ff4fa3;
  font-size: 35px;
  font-weight: bold;
}
.card {
  background: #241839;
  margin: 20px;
  padding: 25px;
  border-radius: 20px;
}
input {
  width: 85%;
  padding: 14px;
  margin: 10px;
  border: 0;
  border-radius: 10px;
}
button {
  background: #ff4fa3;
  color: white;
  border: 0;
  padding: 14px 25px;
  border-radius: 12px;
  margin: 8px;
  font-weight: bold;
}
.premium {
  background: linear-gradient(120deg,#6d35a5,#e83d91);
}
</style>
</head>
<body>
<header>VERONICA ❤️</header>

<div class="card">
<h2>Hoş Geldin!</h2>
<p>Yeni insanlarla tanış, sohbet et.</p>
<input placeholder="E-posta adresin">
<input type="password" placeholder="Şifren">
<br>
<button>Giriş Yap</button>
<button>Kayıt Ol</button>
</div>

<div class="card premium">
<h2>VERONICA PREMIUM ⭐</h2>
<p>Daha fazla özellik, daha fazla tanışma!</p>
<button>Premium'u Keşfet</button>
</div>

<p>VERONICA © 2026</p>
</body>
</html>
